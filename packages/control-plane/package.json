{
  "name": "@blitzos/control-plane",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./hetzner": {
      "types": "./dist/core/providers/hetzner.d.ts",
      "import": "./dist/core/providers/hetzner.js"
    }
  },
  "files": [
    "dist",
    "core/providers/microvm-hosts.js",
    "migrations",
    "README.md",
    "scripts/deploy-helpers.mjs",
    "scripts/deploy.mjs",
    "wrangler.toml"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "deploy": "node scripts/deploy.mjs",
    "test:shell": "sh test/shell-syntax.sh",
    "test:python": "npm run build --silent && node --test test/bootstrap-python.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.wire-drift.json",
    "test": "vitest run && npm run test:python"
  },
  "dependencies": {
    "hono": "4.13.1",
    "teenybase": "0.0.15"
  },
  "devDependencies": {
    "@blitzos/schema": "0.0.0",
    "@cloudflare/vitest-pool-workers": "0.21.1",
    "@cloudflare/workers-types": "5.20260812.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.121.0"
  }
}
