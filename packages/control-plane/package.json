{
  "name": "@blitzos/control-plane",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./hetzner": {
      "types": "./dist/core/compute/hetzner.d.ts",
      "import": "./dist/core/compute/hetzner.js"
    }
  },
  "files": [
    "dist",
    "core/compute/microvm-hosts.js",
    "core/signup-config.js",
    "migrations",
    "README.md",
    "scripts/deploy-helpers.mjs",
    "scripts/deploy.mjs",
    "scripts/ensure-wrangler-config.mjs",
    "wrangler.toml.example"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "blitzdev:build": "node scripts/build-blitzdev.mjs",
    "config": "node scripts/ensure-wrangler-config.mjs",
    "deploy": "node scripts/deploy.mjs",
    "provider:check": "vitest run test/connections-catalog.test.ts -t",
    "test:shell": "sh test/shell-syntax.sh",
    "test:python": "npm run build --silent && node --test test/bootstrap-python.test.mjs",
    "test:bash": "npm run build --silent && node --test test/bootstrap-bash.test.mjs",
    "test:scripts": "node --test test/publish-box-image.test.mjs test/set-box-image-ref.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.wire-drift.json",
    "types": "node scripts/ensure-wrangler-config.mjs && wrangler types --include-runtime=false",
    "pretypecheck": "npm run types",
    "pretest": "npm run types",
    "pretest:blitzdev": "npm run types",
    "test:blitzdev": "vitest run test/blitzdev-closure.test.ts test/blitzdev-emitter.test.ts test/blitzdev-schema.test.ts test/managed-api.test.ts test/assets.test.ts test/box-image-files.test.ts test/route-prefixes.test.ts test/error-envelope.test.ts",
    "test": "vitest run && npm run test:python && npm run test:bash && npm run test:scripts"
  },
  "dependencies": {
    "hono": "4.13.1",
    "smol-toml": "^1.8.0",
    "teenybase": "0.0.14"
  },
  "devDependencies": {
    "@blitzos/schema": "0.0.0",
    "@cloudflare/vitest-pool-workers": "0.21.1",
    "@cloudflare/workers-types": "5.20260812.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.121.0"
  }
}
