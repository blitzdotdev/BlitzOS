{
  "name": "@blitzos/control-plane",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hetzner": {
      "types": "./dist/providers/hetzner.d.ts",
      "import": "./dist/providers/hetzner.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "wrangler.toml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@blitzos/schema": "0.0.0",
    "hono": "4.13.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.1",
    "@cloudflare/workers-types": "5.20260812.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.121.0"
  }
}
