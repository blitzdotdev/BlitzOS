# Reference template for the control-plane Worker config. Generate your
# wrangler.toml from it, then fill in your values:
#   npm run config -w packages/control-plane
# Do not copy this file verbatim: the deploy writes your D1 database_id into
# wrangler.toml, and wrangler refuses to patch a config that holds comments.
# The generated file carries every key below and none of the prose, so keep
# this file as the reference for what each var means.
# wrangler.toml is gitignored — it carries your account-specific IDs. Never
# commit it. Full walkthrough: docs/SELF-HOST.md.

# Worker name in your Cloudflare account. Any name works; it becomes part of your workers.dev origin.
name = "blitz-control-plane"
# Cloudflare account that owns this Worker. Optional when your wrangler login sees exactly one account; required when it sees several, or the deploy cannot choose one. Uncomment and fill in:
# account_id = "<your account id>"
main = "src/worker.ts"
compatibility_date = "2026-08-11"
compatibility_flags = ["nodejs_compat"]

[vars]
# Every var below ships with a deployable value, because several of them can
# only be filled in AFTER a first deploy: the Worker origin does not exist
# until the Worker does. Empty means "not configured yet" and is accepted by
# the deploy; the feature that needs it stays off. Angle-bracket text is a
# placeholder the deploy refuses — never paste one in.

# Public origin of this Worker (workers.dev URL or custom domain). Empty until step 4 of docs/SELF-HOST.md prints your origin; set it and redeploy.
APP_URL = ""
# Box image source: a registry reference, or this Worker's /box-image URL for R2-hosted archives. Empty until step 9; workspaces cannot become ready without it. Modes and values in docs/BOX-IMAGE.md.
# Set by the deploy, never by hand: scripts/deploy.mjs passes the checked-out
# commit as --var GIT_COMMIT_SHA. GET /version reports it, so an operator can
# ask a running deployment which commit it is, instead of guessing from a
# bundle hash (which identifies the webapp build only).
# The empty declaration still has to be here: `wrangler types` builds the Env
# interface from this file, and src/worker.ts reads env.GIT_COMMIT_SHA. A
# deployment config that lacks it is filled in from this line by the deploy, so
# no stored config ever has to be edited for it.
GIT_COMMIT_SHA = ""
# Policy for new cloud workspaces. "deployment-fallback" preserves self-host
# behavior: prefer an org key, then use this deployment's cloud secrets.
# Hosted deployments must set "byok-required" so every org supplies its key.
# Existing workspaces keep their recorded credential source under either value.
CLOUD_WORKSPACE_CREDENTIAL_POLICY = "deployment-fallback"
BOX_IMAGE_REF = ""
# Image tag inside the R2-hosted archive. Empty for registry mode; see docs/BOX-IMAGE.md.
BOX_IMAGE_TAG = ""
# SHA-256 of the R2-hosted archive. Empty for registry mode; see docs/BOX-IMAGE.md.
BOX_IMAGE_SHA256 = ""
# Session cookie lifetime in days (1-3650). Optional, default 30.
SESSION_TTL_DAYS = "30"
# JSON array of Firecracker microVM hosts. '[]' disables the microVM provider. Shapes below.
# WARNING: every configured host requires its MICROVM_<NAME>_TOKEN Worker secret
# (>=32 chars, no whitespace). A missing or weak token makes EVERY request to
# the Worker fail with 500.
MICROVM_HOSTS = '[]'
# Populated shapes — pinned URL and phone-home (dynamic) hosts:
# MICROVM_HOSTS = '[{"name":"lab","url":"https://lab.example:8443","tokenVar":"MICROVM_LAB_TOKEN"},{"name":"home","tokenVar":"MICROVM_HOME_TOKEN","dynamic":true}]'
# Cloudflare account that owns the workspace-tunnel zone (dash.cloudflare.com -> your zone -> Overview). Empty until step 8; required only for browser access to cloud-VM workspaces.
CLOUDFLARE_ACCOUNT_ID = ""
# Cloudflare zone that holds ws-<workspace-id> DNS records (same Overview page). Empty until step 8; required only for browser access to cloud-VM workspaces.
CLOUDFLARE_ZONE_ID = ""
# Domain of that zone, e.g. "workspaces.example.com". Empty = no browser access to cloud-VM workspaces (they boot, but no terminal/chat/files/previews). See docs/TUNNEL.md.
WORKSPACE_TUNNEL_ZONE = ""
# Origin of the checkout surface a paid deployment sends people to when they
# hit a seat limit; the 402 refusal carries "<PAYMENT_URL>/checkout#token=<jwt>".
# Empty on self-host and the refusal simply carries no link — there is no seat
# limit there at all unless the ENTITLEMENTS_API_KEY secret is also set.
# The empty declaration has to stay: `wrangler types` builds the Env interface
# from this file, and src/worker.ts reads env.PAYMENT_URL.
PAYMENT_URL = ""

# ENTITLEMENTS_API_KEY is a Worker SECRET, not a var, so it is not listed here
# (`wrangler secret put ENTITLEMENTS_API_KEY`). Leave it unset unless a billing
# service writes limits into this deployment: unset means no seat gating
# anywhere and PUT /orgs/:id/entitlements answers 404.

# Optional vars (uncomment to set):
# Signup policy: "open" (any Google account) or "invite" (invited emails only). Default "open".
# SIGNUP_MODE = "open"
# Comma-separated email domains allowed to SIGN IN — the gate applies to every sign-in, existing accounts included. Empty allows any domain. Default "".
# ALLOWED_EMAIL_DOMAINS = ""
# Comma-separated Hetzner machine catalog as <type>@<location> entries. Default "cpx21@hil,cpx31@hil".
# HETZNER_MACHINE_TYPES = "cpx21@hil,cpx31@hil"

# 20 calls/minute per auth IP or workspace/invite-creating principal; namespace_id is account-unique.
[[ratelimits]]
name = "REQUEST_RATE_LIMITER"
namespace_id = "1001"
[ratelimits.simple]
limit = 20
period = 60

# R2 bucket for box images and workspace file sync. The deploy script creates the bucket if it does not exist.
[[r2_buckets]]
binding = "BOX_IMAGES"
bucket_name = "blitz-box-images"

# D1 database. No database_id here on purpose: the deploy script creates the
# database on first deploy and writes its ID into your wrangler.toml.
[[d1_databases]]
binding = "DB"
database_name = "blitz-control-plane"
migrations_dir = "migrations"

[observability]
enabled = true

[assets]
directory = "../webapp/dist"
binding = "ASSETS"
not_found_handling = "single-page-application"
# GENERATED — do not hand-edit. Derived from the literal route registrations in
# core/ by scripts/lib/worker-first-routes.mjs. Run
# `npm run routes:sync -w packages/control-plane` after adding, removing, or
# renaming a core route; test/route-prefixes.test.ts fails if you forget.
#
# Your own wrangler.toml does not need this list: the deploy patches the derived
# one in right before `wrangler deploy`, so a stored deployment config never has
# to be edited for a new route again. The copy here exists because two things
# read the file rather than the generator — `wrangler types` and the vitest
# Workers pool.
run_worker_first = [
  "/",
  "/agent/*",
  "/agent-rules",
  "/agent-rules/*",
  "/api/*",
  "/auth/*",
  "/box-image",
  "/box-image/*",
  "/boxes/*",
  "/connect/*",
  "/connections",
  "/connections/*",
  "/folders",
  "/folders/*",
  "/hosts/*",
  "/integrations",
  "/integrations/*",
  "/invite/*",
  "/invites",
  "/invites/*",
  "/leases/*",
  "/machine-types",
  "/machines/*",
  "/me",
  "/members",
  "/members/*",
  "/oauth/*",
  "/operator-tokens",
  "/operator-tokens/*",
  "/orgs",
  "/orgs/*",
  "/proxy/*",
  "/requests",
  "/requests/*",
  "/sessions",
  "/sessions/*",
  "/version",
  "/volumes",
  "/volumes/*",
  "/webapp-state",
  "/workspace-recipes",
  "/workspace-recipes/*",
  "/workspaces",
  "/workspaces/*",
]

[triggers]
crons = ["*/5 * * * *", "0 * * * *", "0 3 * * *"]

# The canonical agent-rules document is the box-image skeleton file, and the
# Worker has no filesystem, so it travels into the bundle as a Text module
# instead of being hand-mirrored into a TypeScript string. `wrangler deploy`
# emits it as its own module and core/agent-rules.ts imports its default export;
# the vitest Workers pool reads the same rule from this file.
[[rules]]
type = "Text"
globs = ["**/agent-rules.md"]
