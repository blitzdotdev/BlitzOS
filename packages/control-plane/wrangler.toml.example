# Template for the control-plane Worker config.
# Copy it to wrangler.toml in this directory and fill in your values:
#   cp wrangler.toml.example wrangler.toml
# wrangler.toml is gitignored — it carries your account-specific IDs and the
# deploy script writes your D1 database_id into it. Never commit it.
# Full walkthrough: docs/SELF-HOST.md.

# Worker name in your Cloudflare account. Any name works; it becomes part of your workers.dev origin.
name = "blitz-control-plane"
main = "src/worker.ts"
compatibility_date = "2026-08-11"
compatibility_flags = ["nodejs_compat"]

[vars]
# Public origin of this Worker (workers.dev URL or custom domain). Required; step 4 of docs/SELF-HOST.md tells you the origin.
APP_URL = "<https origin of this worker>"
# Box image source: a registry reference, or this Worker's /box-image URL for R2-hosted archives. Required; modes and values in docs/BOX-IMAGE.md.
BOX_IMAGE_REF = "<registry ref or worker box-image url>"
# Image tag inside the R2-hosted archive. Empty for registry mode; see docs/BOX-IMAGE.md.
BOX_IMAGE_TAG = ""
# SHA-256 of the R2-hosted archive. Empty for registry mode; see docs/BOX-IMAGE.md.
BOX_IMAGE_SHA256 = ""
# Session cookie lifetime in days (1-3650). Optional, default 30.
SESSION_TTL_DAYS = "30"
# Per-principal cap on non-destroyed workspaces (1-1000). Optional, default 10.
MAX_CONCURRENT_WORKSPACES = "10"
# JSON array of Firecracker microVM hosts. '[]' disables the microVM provider. Shapes below.
# WARNING: every configured host requires its MICROVM_<NAME>_TOKEN Worker secret
# (>=32 chars, no whitespace). A missing or weak token makes EVERY request to
# the Worker fail with 500.
MICROVM_HOSTS = '[]'
# Populated shapes — pinned URL and phone-home (dynamic) hosts:
# MICROVM_HOSTS = '[{"name":"lab","url":"https://lab.example:8443","tokenVar":"MICROVM_LAB_TOKEN"},{"name":"home","tokenVar":"MICROVM_HOME_TOKEN","dynamic":true}]'
# Cloudflare account that owns the workspace-tunnel zone (dash.cloudflare.com -> your zone -> Overview). Required only for browser access to cloud-VM workspaces.
CLOUDFLARE_ACCOUNT_ID = "<cloudflare account id>"
# Cloudflare zone that holds ws-<workspace-id> DNS records (same Overview page). Required only for browser access to cloud-VM workspaces.
CLOUDFLARE_ZONE_ID = "<cloudflare zone id>"
# Domain of that zone, e.g. "workspaces.example.com". Empty = no browser access to cloud-VM workspaces (they boot, but no terminal/chat/files/previews). See docs/TUNNEL.md.
WORKSPACE_TUNNEL_ZONE = ""

# Optional vars (uncomment to set):
# Signup policy: "open" (any Google account) or "invite" (invited emails only). Default "open".
# SIGNUP_MODE = "open"
# Comma-separated email domains allowed to sign up; empty allows any domain. Default "".
# ALLOWED_EMAIL_DOMAINS = ""
# Comma-separated Hetzner machine catalog as <type>@<location> entries. Default "cpx21@hil,cpx31@hil".
# HETZNER_MACHINE_TYPES = "cpx21@hil,cpx31@hil"

# R2 bucket for box images and workspace file sync. The deploy script creates the bucket if it does not exist.
[[r2_buckets]]
binding = "BOX_IMAGES"
bucket_name = "blitz-box-images"

# D1 database. No database_id here on purpose: the deploy script creates the
# database on first deploy and writes its ID into your wrangler.toml.
[[d1_databases]]
binding = "DB"
database_name = "blitz-control-plane"
migrations_dir = "migrations"

[observability]
enabled = true

[assets]
directory = "../webapp/dist"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = [
  "/sessions*",
  "/auth/*",
  "/invite/*",
  "/invites*",
  "/me",
  "/members*",
  "/orgs*",
  "/workspaces*",
  "/workspace-templates*",
  "/agent-rules*",
  "/folders*",
  "/integrations*",
  "/leases*",
  "/requests*",
  "/proxy*",
  "/volumes*",
  "/machine-types*",
  "/webapp-state*",
  "/hosts*",
  "/oauth/*",
  "/boxes/*",
  "/box-image*",
  "/api/*"
]

[triggers]
crons = ["*/5 * * * *", "0 * * * *", "0 3 * * *"]

# The canonical agent-rules document is the box-image skeleton file, and the
# Worker has no filesystem, so it travels into the bundle as a Text module
# instead of being hand-mirrored into a TypeScript string. `wrangler deploy`
# emits it as its own module and core/agent-rules.ts imports its default export;
# the vitest Workers pool reads the same rule from this file.
[[rules]]
type = "Text"
globs = ["**/agent-rules.md"]
