[Unit]
Description=Blitz Firecracker microVM host agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blitz-microvm
Group=blitz-microvm
WorkingDirectory=/var/lib/blitz-microvm
Environment=HOME=/var/lib/blitz-microvm
Environment=USER=blitz-microvm
EnvironmentFile=/etc/blitz/env.defaults
ExecStart=/usr/local/bin/blitz-microvm-agent
Restart=always
RestartSec=1
KillMode=process
TimeoutStopSec=10
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
