[Unit]
Description=Register the current Blitz microVM quick-tunnel URL
After=network-online.target blitz-microvm-tunnel.service
Wants=network-online.target blitz-microvm-tunnel.service

[Service]
Type=simple
User=minjune
Group=minjune
SupplementaryGroups=systemd-journal
EnvironmentFile=/etc/blitz/tunnel-reporter.env
ExecStart=/usr/local/libexec/blitz-tunnel-reporter.sh
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
