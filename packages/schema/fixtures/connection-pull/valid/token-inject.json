{
  "connection": "github",
  "mode": "inject",
  "token": "ghu_test-only-user-access-token",
  "env": [
    { "name": "GH_TOKEN", "value": "ghu_test-only-user-access-token" },
    { "name": "GITHUB_TOKEN", "value": "ghu_test-only-user-access-token" },
    { "name": "GITHUB_PERSONAL_ACCESS_TOKEN", "value": "ghu_test-only-user-access-token" }
  ],
  "header": { "name": "Authorization", "prefix": "Bearer " },
  "expiresAt": 1756000000000
}
