#!/usr/bin/env bash
# Health means "the box can still reach its user", not "the container is up".
#
# The old failure was invisible precisely because the container stayed running:
# memory pressure stalled cloudflared while PID 1 lived, so Docker, the control
# plane, and the workspace list all reported a healthy box that answered
# nothing. This check tests the four listeners and the tunnel process that
# together make the box reachable, and it reports the system slice's own OOM
# counter — a non-zero value there means the reservation failed and the
# boundary needs a smaller user ceiling.
set -uo pipefail

fail() { printf 'unhealthy: %s\n' "$*" >&2; exit 1; }

listeners=$(ss -tln 2>/dev/null) || fail "ss did not run"
for endpoint in '0.0.0.0:22' '127.0.0.1:7443' '127.0.0.1:7445'; do
  grep -Fq "$endpoint" <<<"$listeners" || fail "nothing listens on $endpoint"
done

pgrep -x cloudflared >/dev/null 2>&1 || fail "cloudflared is not running"

# The tunnel process can be alive and still stalled, so prove it is scheduled:
# a request the gateway answers locally costs nothing and fails fast when the
# box is in reclaim.
curl --silent --show-error --fail --max-time 4 --output /dev/null \
  http://127.0.0.1:7445/healthz 2>/dev/null ||
  curl --silent --max-time 4 --output /dev/null http://127.0.0.1:7445/ 2>/dev/null ||
  fail "the gateway did not answer in 4s"

system_slice=/sys/fs/cgroup/blitz-system.slice
if [ -r "$system_slice/memory.events" ]; then
  kills=$(awk '/^oom_kill / {print $2}' "$system_slice/memory.events")
  [ "${kills:-0}" = 0 ] || fail "the system slice was OOM-killed $kills times"
fi

exit 0
