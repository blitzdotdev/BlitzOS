#!/command/with-contenv bash
set -euo pipefail

state_dir=$BLITZ_STATE_DIR
if [ ! -s "$state_dir/origin" ]; then
  echo "register: skipped (no control-plane origin)"
  exit 0
fi
exec /command/s6-setuidgid blitz /usr/bin/env \
  HOME="$state_dir/home" BLITZ_STATE_DIR="$state_dir" \
  /usr/local/bin/blitz-cred register
