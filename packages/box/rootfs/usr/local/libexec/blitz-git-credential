#!/bin/sh
# Git credential helper: answer git's `get` for github.com by minting a token
# through the control plane's agent credentials API.
#
# The box stores no GitHub credential. It holds exactly one credential-shaped
# thing — its own machine bearer, printed by `blitz-cred api-token` — and the
# mint happens on the control plane, which checks the acting member's grants
# at THIS moment, not at clone time. A Disconnect in the panel takes effect on
# the next fetch with no delivery machinery in between.
#
# Every failure path answers nothing and exits 0: git then falls through to
# anonymous access, so a public clone still works on a box nobody has
# connected to GitHub. That silence is deliberate — a failed helper that
# exits non-zero makes git print scary noise on a box that is merely not
# connected, which is a normal state.
set -u

action=${1:-}

# git speaks KEY=value lines terminated by a blank line on stdin, for every
# action. Drain it before deciding anything, so git never takes a SIGPIPE
# writing to a helper that already left.
host=""
while IFS= read -r line; do
  [ -n "$line" ] || break
  case $line in
    host=*) host=${line#host=} ;;
  esac
done

# `store` and `erase` are acknowledged and ignored: there is nothing on the
# box to store into or erase from.
[ "$action" = get ] || exit 0
[ "$host" = github.com ] || exit 0

state_dir=${BLITZ_STATE_DIR:-/var/lib/blitz}
origin=$(cat "$state_dir/origin" 2>/dev/null) || exit 0
[ -n "$origin" ] || exit 0

bearer=$(blitz-cred api-token 2>/dev/null) || exit 0
[ -n "$bearer" ] || exit 0

# A refusal comes back as JSON with no `token` (404 {error, request_id}), so
# `// empty` turns "not connected" into the same quiet fall-through as any
# transport failure. jq given curl's empty stdout also prints nothing.
token=$(
  curl -sS --max-time 30 -X POST -H "Authorization: Bearer $bearer" \
    "$origin/agent/credentials/github/token" 2>/dev/null \
    | jq -r '.token // empty' 2>/dev/null
) || exit 0
[ -n "$token" ] || exit 0

# The token becomes one protocol line. A value with whitespace or a control
# character in it could forge a second attribute, so refuse anything that is
# not a single printable word rather than quote it.
case $token in
  *[![:graph:]]*) exit 0 ;;
esac

printf 'username=x-access-token\npassword=%s\n\n' "$token"
