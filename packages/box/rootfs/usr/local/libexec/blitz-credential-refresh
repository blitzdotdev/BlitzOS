#!/command/with-contenv sh
set -eu

state_dir=$BLITZ_STATE_DIR

if [ ! -s "$state_dir/origin" ]; then
	echo "blitz-credential-refresh: skipped (no control-plane origin)"
	exit 0
fi
if [ ! -s "$state_dir/box-credential.json" ]; then
	echo "blitz-credential-refresh: skipped (no box credential)"
	exit 0
fi

if ! blitz-cred api-token >/dev/null; then
	echo "blitz-credential-refresh: refresh failed; continuing" >&2
fi
exit 0
