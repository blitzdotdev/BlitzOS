#!/command/with-contenv bash
set -euo pipefail

state_dir=$BLITZ_STATE_DIR

# Runs after register, so the box access token is freshly issued. The
# prerequisites and every failure path are owned by blitz-rules itself: it
# reads $BLITZ_STATE_DIR/origin and box-credential.json, logs why a sync was
# skipped, keeps the baked rules blitz-init-state installed, and exits 0 —
# so this oneshot cannot fail the boot transition.
exec /command/s6-setuidgid blitz /usr/bin/env \
  HOME="$state_dir/home" BLITZ_STATE_DIR="$state_dir" \
  /usr/local/bin/blitz-rules sync
