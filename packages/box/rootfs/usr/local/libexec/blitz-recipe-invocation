# shellcheck shell=bash
# blitz-recipe-invocation — guest-side parser for the recipe invocation files
# a recipe launch writes to /var/lib/blitz/recipe (the `recipe invocation
# files` contract row in CLAUDE.md; writer: control-plane core/bootstrap.ts).
#
# Sourced, never executed: blitz-term sources it when a TUI session is
# created, and packages/box/actor/test/recipe-invocation-guest.test.ts drives
# the same function against packages/schema/fixtures/recipe-invocation/. One
# implementation on purpose — do not fork this parsing anywhere else.
#
# recipe_invocation_load <dir>
#   Reads <dir>/invocation.env and <dir>/prompt.txt into RECIPE_HARNESS,
#   RECIPE_MODEL, RECIPE_EFFORT (empty string when a key is unset) and
#   RECIPE_PROMPT (the prompt.txt bytes, trailing newlines preserved).
#   Returns nonzero, with all four reset to empty, when either file is
#   missing. The env file is trusted control-plane output — one KEY='value'
#   line per set key, HARNESS then MODEL then EFFORT, values single-quoted
#   with the writer's shellQuote escaping (the fixtures pin the quoting) — so
#   sourcing it IS the parser.
recipe_invocation_load() {
  RECIPE_HARNESS='' RECIPE_MODEL='' RECIPE_EFFORT='' RECIPE_PROMPT=''
  if [ ! -f "$1/invocation.env" ] || [ ! -f "$1/prompt.txt" ]; then
    return 1
  fi
  local HARNESS='' MODEL='' EFFORT=''
  # The locals above catch the sourced assignments, so nothing leaks into the
  # caller's environment beyond the four RECIPE_* results.
  . "$1/invocation.env"
  RECIPE_HARNESS=$HARNESS
  RECIPE_MODEL=$MODEL
  RECIPE_EFFORT=$EFFORT
  # Command substitution strips trailing newlines; the sentinel keeps the
  # prompt byte-exact (the `newlines` fixture pins interior CRLF and a missing
  # trailing newline).
  RECIPE_PROMPT=$(cat "$1/prompt.txt" && printf x) || return 1
  RECIPE_PROMPT=${RECIPE_PROMPT%x}
  return 0
}
