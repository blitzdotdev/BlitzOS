#!/usr/bin/env bash
set -euo pipefail

# Launcher for the codex tmux tab. blitz-term execs this instead of codex so
# the box can offer a headless sign-in before the TUI starts.
#
# Everything between the two BEGIN/END markers below is that offer, and only
# that. If it misbehaves, delete the marked region — the trailing exec is the
# whole of the original behaviour and the tab keeps working without it.

# ---------------------------------------------------------------------------
# BEGIN blitz device-auth offer — REMOVE AS ONE UNIT
#
# YANK PROCEDURE: delete every line down to the END marker. Nothing outside
# the region refers to anything inside it. The tab then behaves exactly as it
# did before this block existed: it execs codex and lets codex decide.
#
# WHY IT EXISTS: codex's browser sign-in redirects to localhost:1455. In a
# remote workspace that localhost is the reader's computer, not this box, so
# the callback never arrives and the flow hangs. Codex's device-code flow is
# the supported headless path, but it is opt-in behind a flag: there is no
# config key for it on the pinned codex-cli 0.147.0 (`codex login --help`
# lists --device-auth, --with-api-key and --with-access-token, and nothing
# else), so a wrapper is the only place the choice can be made.
#
# WHO IT IS FOR: a box with no credential broker and no API key — the
# self-hosted `docker run` install. On a hosted workspace all three probes
# below fall through and this region does nothing at all.

# codex_authenticated reports whether codex can already reach a model.
#
# It must probe all three ways this box authenticates codex, because
# `codex login status` alone answers only for the third and reports
# "Not logged in" for the other two. Verified against codex-cli 0.147.0:
# a config.toml carrying the broker block and no auth.json prints
# "Not logged in" and exits 1, and so does OPENAI_API_KEY on its own.
# Gating on status alone therefore hijacks every working hosted tab into a
# device prompt, which is the failure this function exists to prevent.
codex_authenticated() {
  local codex_home=${CODEX_HOME:-${HOME:-}/.codex}

  # 1. The credential broker. `blitz-cred register` writes an auth hook into
  #    config.toml and deliberately writes NO auth.json — codex pulls its own
  #    token every refresh_interval_ms. The hook's path is the signal.
  if [ -r "$codex_home/config.toml" ] &&
    grep -Fq '/usr/local/bin/blitz-cred-codex' "$codex_home/config.toml"; then
    return 0
  fi

  # 2. A plain API key the member exported themselves. codex reads these
  #    itself; its own status check ignores them
  #    (enable_codex_api_key_env is false there).
  if [ -n "${CODEX_API_KEY:-}" ] || [ -n "${OPENAI_API_KEY:-}" ]; then
    return 0
  fi

  # 3. A ChatGPT sign-in codex stored itself, which is what status reads.
  codex login status >/dev/null 2>&1
}

# fallback_shell drops the reader into their login shell after a sign-in that
# did not finish, so the tab stays usable instead of closing.
#
# Shell resolution matches blitz-term's plain_shell, including the passwd
# lookup: tmux hands later sessions a bare bootstrap environment snapshot in
# which SHELL is not set, and substituting /bin/bash there would silently move
# a member off their own shell.
fallback_shell() {
  local shell=${SHELL:-}
  if [ -z "$shell" ]; then
    shell=$(getent passwd "$(id -u)" | cut -d: -f7)
  fi
  if [ ! -x "$shell" ]; then
    echo "codex: user shell is not executable: $shell" >&2
    exit 1
  fi
  echo "Codex sign-in did not complete. Retry with: codex login --device-auth" >&2
  # A recipe launch passes its prompt in "$@", and blitz-term has already
  # renamed the invocation files to .delivered by the time this runs, so the
  # prompt cannot be re-delivered. Say so rather than dropping it in silence.
  if [ "$#" -gt 0 ]; then
    echo "codex: the queued prompt was not delivered. It is reprinted below." >&2
    printf '%s\n' "$@" >&2
  fi
  exec "$shell" -l
}

if ! codex_authenticated; then
  echo "Codex is not signed in. Starting device authentication..." >&2
  # Ctrl-C is the only way to cancel a device-code flow: codex installs no
  # SIGINT handler, so the pty signals the whole foreground group and codex
  # dies FROM SIGINT. Bash re-raises when a foreground child is killed that
  # way, which would take this launcher — the tmux session's root process —
  # down with it and close the tab before the fallback could run.
  #
  # CATCH the signal, do not ignore it. `trap '' INT` would work here too, but
  # SIG_IGN survives exec: codex would inherit it and stop responding to Ctrl-C
  # altogether, leaving the reader no way out of the device prompt. A trap with
  # a handler is reset to the default disposition in the child, so codex still
  # dies on Ctrl-C exactly as before while this process survives to fall back.
  login_status=0
  login_cancelled=0
  trap 'login_cancelled=1' INT
  codex login --device-auth || login_status=$?
  trap - INT
  if [ "$login_cancelled" -ne 0 ] || [ "$login_status" -ne 0 ]; then
    fallback_shell "$@"
  fi
fi
#
# END blitz device-auth offer
# ---------------------------------------------------------------------------

exec codex --dangerously-bypass-approvals-and-sandbox "$@"
