#!/usr/bin/env bash
set -euo pipefail

workspace=/workspace
state_dir=${BLITZ_STATE_DIR:-/var/lib/blitz}

plain_shell() {
  local shell=${SHELL:-}
  if [ -z "$shell" ]; then
    shell=$(getent passwd "$(id -u)" | cut -d: -f7)
  fi
  if [ ! -x "$shell" ]; then
    echo "terminal: user shell is not executable" >&2
    exit 1
  fi
  cd "$workspace"
  exec "$shell" -l
}

if [ "$#" -eq 0 ]; then
  plain_shell
fi
if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
  echo "terminal: expected <terminal|claude|codex> <session-key> [ro]" >&2
  exit 2
fi

session_type=$1
session_key=$2
mode=${3:-rw}

# Tabs are workspace-scoped: agents always run with permission prompts off.
case "$session_type" in
  terminal) session_prefix=term; session_cmd=() ;;
  claude) session_prefix=claude; session_cmd=(claude --dangerously-skip-permissions --permission-mode bypassPermissions) ;;
  codex) session_prefix=codex; session_cmd=(codex --dangerously-bypass-approvals-and-sandbox) ;;
  *) echo "terminal: unsupported session type: $session_type" >&2; exit 2 ;;
esac
case "$session_key" in
  ''|*[!A-Za-z0-9_-]*)
    echo "terminal: session key must contain only A-Z, a-z, 0-9, _ or -" >&2
    exit 2
    ;;
esac
if [ "${#session_key}" -gt 128 ]; then
  echo "terminal: session key must be at most 128 characters" >&2
  exit 2
fi
if [ "$mode" != rw ] && [ "$mode" != ro ]; then
  echo "terminal: optional third argument must be ro" >&2
  exit 2
fi

session="$session_prefix-$session_key"

new_session() {
  tmux -u new-session -d -s "$session" -c "$workspace" "${session_cmd[@]}"
}

if [ "$mode" = ro ]; then
  # An observer attaches to what is already running and never starts
  # anything: creating on demand here would let a read-only visitor spawn
  # agent processes at will, one per session key they invent.
  if ! tmux has-session -t "=$session" 2>/dev/null; then
    echo "terminal: no session to observe yet" >&2
    exit 3
  fi
  exec tmux -u attach-session -r -t "=$session"
fi

# An agent reads its skills once, when it starts, and the mint that delivers a
# skill (.claude/skills/<provider>/SKILL.md) is the same one that fills env.d.
# A tab opened before the first sync would therefore run a whole session
# believing the workspace is connected to nothing. Only on the create path: an
# attach re-enters a harness that already scanned, so syncing for it would buy
# nothing and stall every reconnect. `command -v` guards the way
# /etc/profile.d/blitz-creds.sh does, so a stripped image loses a sync and not
# a terminal, and BLITZ_STATE_DIR is passed explicitly so the sync can never
# write to a directory other than the one sourced below.
case "$session_type" in
  claude|codex)
    if ! tmux has-session -t "=$session" 2>/dev/null &&
        command -v timeout >/dev/null 2>&1 &&
        command -v blitz-cred >/dev/null 2>&1; then
      BLITZ_STATE_DIR="$state_dir" timeout 10 blitz-cred sync >/dev/null 2>&1 || :
    fi
    ;;
esac

# Everything the workspace has connected lives in the credential env.d
# directory, which a login shell sources as a whole glob through
# /etc/profile.d/blitz-creds.sh. tmux execs the commands below without a login
# shell, so the same glob is sourced here, in the same order — 00-workspace.sh
# first, a later integration file winning a shared name. An agent tab that
# cannot read the credential its own workspace connected is the bug; the chat
# actor merges these identical files (box/actor/src/credentials.ts) so the two
# surfaces cannot disagree about what a variable holds.
for credential_env_file in "$state_dir"/creds/env.d/*.sh; do
  [ -r "$credential_env_file" ] && . "$credential_env_file" || :
done
unset credential_env_file

# Recipe invocation delivery (plans/RECIPES.md Phase 2): a recipe launch
# leaves /var/lib/blitz/recipe/{invocation.env,prompt.txt} on the state
# volume. The first rw session that CREATES the tmux session for the matching
# harness consumes them: model/effort flags plus the prompt as one final
# positional argument (tmux execs a multi-argument command directly, so the
# prompt bytes never pass through a shell). Renaming invocation.env is the
# atomic once-only claim and happens before tmux starts. `new-session -A` on
# an existing session attaches and never re-injects (has-session decides),
# `ro` exited above without consuming, and HARNESS=chat files belong to the
# bootstrap chat sender, never to blitz-term.
recipe_dir="${BLITZ_STATE_DIR:-/var/lib/blitz}/recipe"
case "$session_type" in
  claude|codex)
    if [ -f "$recipe_dir/invocation.env" ] &&
        ! tmux has-session -t "=$session" 2>/dev/null; then
      . "$(dirname -- "$0")/blitz-recipe-invocation"
      if recipe_invocation_load "$recipe_dir" &&
          [ "$RECIPE_HARNESS" = "$session_type" ] &&
          mv "$recipe_dir/invocation.env" "$recipe_dir/invocation.env.delivered" 2>/dev/null; then
        # Losing the rename means a concurrent creator already took delivery.
        mv "$recipe_dir/prompt.txt" "$recipe_dir/prompt.txt.delivered" 2>/dev/null || :
        if [ "$session_type" = claude ]; then
          if [ -n "$RECIPE_MODEL" ]; then session_cmd+=(--model "$RECIPE_MODEL"); fi
          if [ -n "$RECIPE_EFFORT" ]; then session_cmd+=(--effort "$RECIPE_EFFORT"); fi
        else
          if [ -n "$RECIPE_MODEL" ]; then session_cmd+=(-m "$RECIPE_MODEL"); fi
          if [ -n "$RECIPE_EFFORT" ]; then session_cmd+=(-c "model_reasoning_effort=$RECIPE_EFFORT"); fi
        fi
        session_cmd+=("$RECIPE_PROMPT")
      fi
    fi
    ;;
esac

exec tmux -u new-session -A -s "$session" -c "$workspace" "${session_cmd[@]}"
