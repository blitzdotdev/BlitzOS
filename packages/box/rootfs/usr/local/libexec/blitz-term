#!/usr/bin/env bash
set -euo pipefail

workspace=/workspace
state_dir=${BLITZ_STATE_DIR:-/var/lib/blitz}

plain_shell() {
  local shell=${SHELL:-}
  if [ -z "$shell" ]; then
    shell=$(getent passwd "$(id -u)" | cut -d: -f7)
  fi
  if [ ! -x "$shell" ]; then
    echo "terminal: user shell is not executable" >&2
    exit 1
  fi
  cd "$workspace"
  # A bare connection still runs user work, so it belongs under the user
  # ceiling. Its own leaf, keyed by pid, so one runaway plain shell cannot
  # take another one down with it.
  exec /usr/local/bin/blitz-cgroup enter "user/tab-plain-$$" -- "$shell" -l
}

if [ "$#" -eq 0 ]; then
  plain_shell
fi
if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
  echo "terminal: expected <terminal|claude|codex> <session-key> [ro|kill]" >&2
  exit 2
fi

session_type=$1
session_key=$2
mode=${3:-rw}

# Tabs are workspace-scoped: agents always run with permission prompts off.
case "$session_type" in
  terminal) session_prefix=term; session_cmd=() ;;
  claude) session_prefix=claude; session_cmd=(claude --dangerously-skip-permissions --permission-mode bypassPermissions) ;;
  codex) session_prefix=codex; session_cmd=("$(dirname -- "$0")/blitz-codex-session") ;;
  *) echo "terminal: unsupported session type: $session_type" >&2; exit 2 ;;
esac
case "$session_key" in
  ''|*[!A-Za-z0-9_-]*)
    echo "terminal: session key must contain only A-Z, a-z, 0-9, _ or -" >&2
    exit 2
    ;;
esac
if [ "${#session_key}" -gt 128 ]; then
  echo "terminal: session key must be at most 128 characters" >&2
  exit 2
fi
if [ "$mode" != rw ] && [ "$mode" != ro ] && [ "$mode" != kill ]; then
  echo "terminal: optional third argument must be ro or kill" >&2
  exit 2
fi

session="$session_prefix-$session_key"

if [ "$mode" = kill ]; then
  # Only an explicit tab CLOSE reaches this branch. A disconnect, a reload and
  # a navigation all leave the session running, which is what makes re-attach
  # the normal path (plans/LODY-TERMINAL-TABS.md §4.3, §4.4). The session name
  # is built above, so the close door never has to know the naming rule.
  # An absent session is a success: the tab is gone either way.
  tmux kill-session -t "=$session" 2>/dev/null || :
  exit 0
fi

if [ "$mode" = ro ]; then
  # An observer attaches to what is already running and never starts
  # anything: creating on demand here would let a read-only visitor spawn
  # agent processes at will, one per session key they invent.
  if ! tmux has-session -t "=$session" 2>/dev/null; then
    echo "terminal: no session to observe yet" >&2
    exit 3
  fi
  exec tmux -u attach-session -r -t "=$session"
fi

# No secret passes through here. Every credential is pulled at the moment of
# use — the agent's own curl against the control plane's /agent/* API, with a
# bearer from `blitz-cred api-token` — so a tab carries nothing that outlives
# its grant and a Disconnect takes effect without restarting anything.
#
# tmux gives a NEW session the environment of the client that created it only
# when that client also STARTS the server; every later session copies the
# server's snapshot instead. A box boots a detached `blitz-rc` session first,
# so the server snapshot is whatever bootstrap's `docker exec` held — no LANG.
# `-e NAME=VALUE` writes the locale into the session environment explicitly, so
# delivery does not depend on who started the server. ttyd hands blitz-term the
# pair; the fallback covers the callers that do not.
#
# -e applies on CREATE only. `new-session -A` that attaches to a live session
# leaves that session's environment untouched.
session_env=(-e "LANG=${LANG:-C.UTF-8}" -e "LC_ALL=${LC_ALL:-C.UTF-8}")

# THE CGROUP WRAPPER GOES ON THE PANE COMMAND, NOT ON THIS SCRIPT. tmux forks
# every pane from its long-lived server process, so this script's own cgroup is
# not what a pane inherits. Wrapping the command tmux execs is the one place
# the join lands in the right process.
#
# One leaf per session name. A runaway agent in one tab is killed as a group,
# and every other tab, the tmux server, and ttyd itself keep running — that is
# the whole point of a per-tab leaf over a single shared user scope.
#
# `new-session -A` ignores the command when it attaches to a live session, so
# an attach keeps the leaf the session already had.
if [ "${#session_cmd[@]}" -eq 0 ]; then
  pane_shell=${SHELL:-}
  if [ -z "$pane_shell" ]; then
    pane_shell=$(getent passwd "$(id -u)" | cut -d: -f7)
  fi
  session_cmd=("$pane_shell" -l)
fi
session_cmd=(/usr/local/bin/blitz-cgroup enter "user/tab-$session" -- "${session_cmd[@]}")

exec tmux -u new-session -A -s "$session" -c "$workspace" "${session_env[@]}" "${session_cmd[@]}"
