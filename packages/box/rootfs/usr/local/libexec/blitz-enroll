#!/command/with-contenv bash
set -euo pipefail

state_dir=${BLITZ_STATE_DIR:-/var/lib/blitz}
if [ ! -s "$state_dir/origin" ]; then
  echo "enroll: skipped (no control-plane origin)"
  exit 0
fi
if [ -s "$state_dir/box-credential.json" ]; then
  echo "enroll: skipped (credential exists)"
  exit 0
fi
origin=$(sed -n '1p' "$state_dir/origin")
exec /command/s6-setuidgid blitz /usr/bin/env \
  HOME="$state_dir/home" BLITZ_STATE_DIR="$state_dir" \
  /usr/local/bin/blitz-cred enroll --origin "$origin"
