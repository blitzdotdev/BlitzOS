#!/bin/sh
set -eu

usage() {
  echo 'usage: blitz teenyapp <add <url> [--title <name>]|list|rm <url>|open <port> [--path <path>] [--title <name>]>' >&2
  echo '       blitz connections open <provider>' >&2
  exit 2
}

group=${1:-}
case "$group" in
  # `preview` predates the teenyapp rename and stays a silent alias: same
  # verbs, same marker files, same gateway wire. Only the documented name
  # changed.
  teenyapp|preview) group=teenyapp ;;
  connections) ;;
  *) usage ;;
esac
shift
action=${1:-}
[ -n "$action" ] || usage
shift

previews_path=/var/lib/blitz/previews.json
# The focus marker paths are overridable so the producer conformance tests can
# point them at temp files; in the box they are always the canonical locations.
focus_path="${BLITZ_PREVIEW_FOCUS_PATH:-/var/lib/blitz/preview-focus.json}"
connections_focus_path="${BLITZ_CONNECTIONS_FOCUS_PATH:-/var/lib/blitz/connections-focus.json}"

exec node - "$previews_path" "$focus_path" "$connections_focus_path" "$group" "$action" "$@" <<'NODE'
const fs = require('node:fs');

const [previewsPath, focusPath, connectionsFocusPath, group, action, ...args] = process.argv.slice(2);

function fail(message, status = 1) {
  console.error(`blitz ${group}: ${message}`);
  process.exit(status);
}

function entry(value) {
  return value !== null
    && typeof value === 'object'
    && !Array.isArray(value)
    && typeof value.url === 'string'
    && value.url.length > 0
    && typeof value.title === 'string'
    && typeof value.source === 'string'
    && Number.isSafeInteger(value.createdAt);
}

function readEntries() {
  let source;
  try {
    source = fs.readFileSync(previewsPath, 'utf8');
  } catch (error) {
    if (error.code === 'ENOENT') return [];
    throw error;
  }
  if (source.trim() === '') return [];
  const value = JSON.parse(source);
  if (!Array.isArray(value)) fail('state file is not a JSON array');
  return value.filter(entry);
}

function atomicWrite(path, contents) {
  const temporaryPath = `${path}.tmp.${process.pid}.${Date.now()}`;
  try {
    fs.writeFileSync(temporaryPath, contents, { flag: 'wx', mode: 0o600 });
    fs.chmodSync(temporaryPath, 0o600);
    fs.renameSync(temporaryPath, path);
  } catch (error) {
    try {
      fs.unlinkSync(temporaryPath);
    } catch {}
    throw error;
  }
}

function writeEntries(entries) {
  atomicWrite(previewsPath, `${JSON.stringify(entries)}\n`);
}

// Mirrors packages/schema/src/preview.ts. The Go gateway keeps the same set in
// `excludedPorts`; all three are pinned to
// packages/schema/fixtures/preview-ports/reserved.json.
const RESERVED_PORTS = new Set([22, 7443, 7444, 7445, 7446, 17445]);
// The control plane refuses a longer `tabs.tabs[].path` outright, and a refused
// write takes the whole tab layout down with it, so the producer never emits a
// path the persisted document cannot carry.
const MAX_PATH_LENGTH = 4096;

// Mirrors `isProviderName` in packages/schema/src/provider-name.ts — the one
// provider-name rule — which this guest script cannot import, so the fixture
// corpus packages/schema/fixtures/connections-focus/ is what pins the two
// together (along with the Go gateway's parseConnectionsFocus and the
// browser's). Provider names are catalog ids or member-named generic
// connections: lowercase slugs, 63 characters at most (the control plane's
// grant validator cap, PROVIDER_NAME in core/connections/user-grants.ts).
const PROVIDER_PATTERN = /^[a-z0-9][a-z0-9._-]{0,62}$/;

function openPreview() {
  if (args.length === 0) fail('expected open <port> [--path <path>] [--title <name>]', 2);
  const portText = args[0];
  if (!/^[0-9]+$/.test(portText)) {
    fail('port must be an integer between 1024 and 65535', 2);
  }
  const port = Number(portText);
  if (!Number.isSafeInteger(port) || port < 1024 || port > 65535 || RESERVED_PORTS.has(port)) {
    fail('port must be an integer between 1024 and 65535 and not reserved by the box', 2);
  }
  let path = '/';
  let title = `port ${port}`;
  for (let index = 1; index < args.length; index += 2) {
    const flag = args[index];
    const value = args[index + 1];
    if (value === undefined) fail(`missing value for ${flag}`, 2);
    if (flag === '--path') path = value;
    else if (flag === '--title') title = value;
    else fail(`unsupported option: ${flag}`, 2);
  }
  if (!path.startsWith('/')) fail('--path must start with /', 2);
  if (path.split('/').includes('..')) fail('--path must not contain a .. segment', 2);
  if (path.length > MAX_PATH_LENGTH) fail(`--path must be at most ${MAX_PATH_LENGTH} characters`, 2);
  if (/[\r\n]/.test(path)) fail('--path must not contain a carriage return or line feed', 2);
  if (/[\r\n]/.test(title)) fail('--title must not contain a carriage return or line feed', 2);
  atomicWrite(focusPath, `${JSON.stringify({ version: 1, port, path, title, requestedAt: Date.now() })}\n`);
  process.exit(0);
}

function openConnections() {
  if (action !== 'open') fail(`unsupported command: ${action}`, 2);
  if (args.length !== 1) fail('expected open <provider>', 2);
  const provider = args[0];
  if (!PROVIDER_PATTERN.test(provider)) {
    fail('provider must be 1-63 characters of a-z, 0-9, ., _ or -, starting alphanumeric', 2);
  }
  atomicWrite(connectionsFocusPath, `${JSON.stringify({ version: 1, provider, requestedAt: Date.now() })}\n`);
  process.exit(0);
}

try {
  if (group === 'connections') {
    openConnections();
  }
  if (action === 'add') {
    if (args.length !== 1 && !(args.length === 3 && args[1] === '--title')) {
      fail('expected add <url> [--title <name>]', 2);
    }
    const url = args[0];
    let parsed;
    try {
      parsed = new URL(url);
    } catch {
      fail('URL must be a well-formed http(s) URL');
    }
    if ((parsed.protocol !== 'http:' && parsed.protocol !== 'https:') || parsed.host === '') {
      fail('URL must be a well-formed http(s) URL');
    }
    const title = args.length === 3 ? args[2] : parsed.host;
    const entries = readEntries().filter((item) => item.url !== url);
    entries.push({ url, title, source: 'agent', createdAt: Date.now() });
    writeEntries(entries);
    process.exit(0);
  }
  if (action === 'list') {
    if (args.length !== 0) fail('list takes no arguments', 2);
    for (const item of readEntries()) console.log(`${item.title} — ${item.url}`);
    process.exit(0);
  }
  if (action === 'rm') {
    if (args.length !== 1) fail('expected rm <url>', 2);
    let exists = true;
    try {
      fs.accessSync(previewsPath);
    } catch (error) {
      if (error.code === 'ENOENT') exists = false;
      else throw error;
    }
    if (!exists) process.exit(0);
    writeEntries(readEntries().filter((item) => item.url !== args[0]));
    process.exit(0);
  }
  if (action === 'open') {
    openPreview();
  }
  fail(`unsupported command: ${action}`, 2);
} catch (error) {
  fail(error instanceof Error ? error.message : String(error));
}
NODE
