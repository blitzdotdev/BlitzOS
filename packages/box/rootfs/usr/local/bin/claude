#!/bin/sh
# PATH shim for Claude Code. Today it only execs, and that is the whole file.
#
# IT NO LONGER MINTS. The shim used to fetch an OAuth token from the credential
# broker and hand it to the CLI. The broker is deleted. Claude reads its own
# store under HOME, and an explicitly supplied CLAUDE_CODE_OAUTH_TOKEN reaches
# it untouched.
#
# IT STILL EXISTS BECAUSE CALLERS NAME IT. The Lody adapter points at this exact
# path (`packages/webapp/src/lody/agent-configs.ts`), and the auto-updater
# rewrites the npm prefix in place, so a stable name is what those callers pin.
#
# The auto-updater stays on. New CLI versions bring new models with no rebake.

exec /opt/blitz/npm/bin/claude "$@"
