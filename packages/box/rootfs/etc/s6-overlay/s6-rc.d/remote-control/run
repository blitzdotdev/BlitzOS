#!/command/with-contenv bash
# Claude Remote Control: the member picks this workspace as a target on
# claude.ai and drives the box from there. No visible terminal tab.
#
# WHY A SERVICE AND NOT A BOOTSTRAP tmux SESSION: the previous shape ran this
# from `docker exec` inside a detached tmux session (parked in #29). That
# session created the box's tmux server from a bare environment, and every
# later tab inherited it. A service also survives a VM reboot, which the
# bootstrap session did not.
#
# WHY A FILE POLL AND NOT A claude RUN: `claude rc` refuses to start when the
# box is logged out, and a logged-out run rewrites ~/.claude.json — that is how
# a loop calling claude every few seconds erased a login the member had just
# finished in a tab. `.credentials.json` is what an interactive `/login`
# writes, so the cheap file test is the login detector. There is deliberately
# no deadline: the member may log in an hour after the box boots.
#
# WHY NOT THE PATH SHIM: /usr/local/bin/claude injects CLAUDE_CODE_OAUTH_TOKEN
# from the broker. Remote Control rejects it outright ("Long-lived tokens are
# limited to inference-only"), so call the pinned binary and unset the three
# token variables a template environment could also set.
#
# WHY A PTY: Remote Control opens an interactive session. `script` supplies the
# pty without involving tmux, so this can never own the box's tmux server.
#
# WHY THE PERMISSION MODE ON THIS LINE: a workspace is the permission boundary,
# so an agent must never stop for a prompt. `claude rc` copies its own
# `--permission-mode` onto every session it spawns for claude.ai. Measured at
# the pinned 2.1.228: the child of `rc --permission-mode bypassPermissions` runs
# `--print … --permission-mode bypassPermissions`. A bare `rc` gives the child
# no mode, so claude.ai chooses one instead.
#
# DO NOT COPY THE TERMINAL-TAB FLAGS HERE. Tabs also pass
# `--dangerously-skip-permissions`. `rc` parses its own flag set and answers
# "Error: Unknown argument: --dangerously-skip-permissions", then exits. The
# service would fail on every restart.
#
# THE MODE IS A START STATE, NOT A LOCK. claude.ai may send
# `set_permission_mode` at any time. 2.1.228 refuses only `bypassPermissions`
# and `auto`; it accepts plan, acceptEdits, dontAsk and default with no check.
# No setting forbids those. `permissions.disableBypassPermissionsMode` is the
# only mode policy, and it removes bypass. Launching in bypass also makes bypass
# reachable in the claude.ai picker, which a bare `rc` does not.
set -uo pipefail

state_dir=${BLITZ_STATE_DIR:-/var/lib/blitz}
home=$state_dir/home
credentials="$home/.claude/.credentials.json"
log="$state_dir/remote-control.log"
attempts="$state_dir/.remote-control-attempts"

# Escalating backoff. s6 restarts a longrun the moment its run script exits,
# and every attempt starts the claude binary, so a lasting failure must not
# spin. The file's own mtime is the time of the last restart: an hour with no
# restart means the service was healthy, so the count starts again.
[ -n "$(find "$attempts" -mmin +60 2>/dev/null)" ] && rm -f "$attempts"
count=$(cat "$attempts" 2>/dev/null || echo 0)
case "$count" in ''|*[!0-9]*) count=0 ;; esac
echo $((count + 1)) > "$attempts"
delay=$((count * 10))
[ "$delay" -gt 120 ] && delay=120
[ "$delay" -gt 0 ] && sleep "$delay"

announced=0
while [ ! -s "$credentials" ]; do
	if [ "$announced" -eq 0 ]; then
		echo "remote-control: waiting for an interactive claude.ai login"
		announced=1
	fi
	sleep 15
done

# claude's own output goes to a file the member and the agent can read. s6
# sends service output to the container's stdout, which needs `docker logs` on
# the VM host — nobody working inside the box can reach it.
[ -f "$log" ] || install -m 0644 /dev/null "$log"
[ "$(stat -c %s "$log" 2>/dev/null || echo 0)" -gt 1048576 ] && : > "$log"

# claude trusts a directory by its path, and it refuses to run in one it does
# not trust. s6 starts a service in its own service directory, whose path also
# changes on every boot, so claude asked to be trusted there instead of in the
# workspace: "Workspace not trusted. Please run `claude` in
# /run/s6-rc:s6-rc-init:.../servicedirs/remote-control first". Terminal tabs
# start in /workspace (blitz-term passes tmux `-c`), so entering it here also
# means the login the member has to perform already trusted this path.
cd /workspace || {
	echo "remote-control: /workspace is missing"
	exit 1
}

launch() {
	exec /command/s6-setuidgid blitz /usr/bin/env \
		-u CLAUDE_CODE_OAUTH_TOKEN -u ANTHROPIC_API_KEY -u ANTHROPIC_BASE_URL \
		HOME="$home" USER=blitz LANG=C.UTF-8 LC_ALL=C.UTF-8 \
		/usr/bin/script -qec \
		'/opt/blitz/npm/bin/claude rc --permission-mode bypassPermissions' /dev/null
}

echo "remote-control: login present, connecting"
# First run on a box asks "Enable Remote Control? (y/n)". With no answer the
# process dies and the service restarts into the same question forever. claude
# records the answer as `remoteDialogSeen`, so send the `y` only while that is
# absent: a later run would deliver it into the session as a message instead.
# `script` keeps the pty open after this input ends, so the session survives.
if grep -qs '"remoteDialogSeen":true' "$home/.claude.json" "$home/.claude/.config.json"; then
	launch < /dev/null >> "$log" 2>&1
else
	launch <<< y >> "$log" 2>&1
fi
