{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    ".idea/**",
    "scratchpad/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.wrangler/**",
    "**/.managed-dist/**",
    "**/integration/results/**",
    "packages/box/test/.smoke-tmp/**",
    "packages/broker/internal/vendor/**",
    "tools/oxlint/anti-slop/**",
    "tools/oxlint/blitz-house/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "blitz-house",
      "specifier": "./tools/oxlint/blitz-house/index.ts"
    }
  ],
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": [
      "error",
      {
        "allowInTypeGuards": true
      }
    ],
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  },
  "overrides": [
    {
      "files": [
        "packages/control-plane/core/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"
      ],
      "rules": {
        "blitz-house/no-raw-fetch": [
          "error",
          {
            "allowFiles": [
              "packages/control-plane/core/providers/json-fetch.ts",
              "packages/control-plane/core/credentials/proxy.ts",
              "packages/control-plane/core/credentials/minters/app-jwt/github-app.ts",
              "packages/control-plane/core/providers/hetzner.ts",
              "packages/control-plane/core/workspace-tunnels.ts"
            ]
          }
        ],
        "blitz-house/no-console-in-core": [
          "error",
          {
            "allowFiles": [
              "packages/control-plane/core/app.ts",
              "packages/control-plane/core/janitors.ts",
              "packages/control-plane/core/providers/microvm-host-registry.ts",
              "packages/control-plane/core/providers/microvm.ts"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"
      ],
      "excludeFiles": [
        "packages/**/test/**",
        "packages/**/tests/**",
        "packages/**/tools/**",
        "packages/**/*.test.*",
        "packages/**/*.spec.*"
      ],
      "rules": {
        "max-lines": [
          "warn",
          {
            "max": 700,
            "skipBlankLines": false,
            "skipComments": false
          }
        ]
      }
    }
  ]
}
