{
  "name": "blitz-core",
  "private": true,
  "version": "1.0.0",
  "description": "The open core of BlitzOS. Apache-2.0.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blitzdotdev/blitz-core.git"
  },
  "bugs": {
    "url": "https://github.com/blitzdotdev/blitz-core/issues"
  },
  "homepage": "https://github.com/blitzdotdev/blitz-core#readme",
  "type": "commonjs",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260804.1": true,
    "workerd@1.20260811.1": true,
    "workerd@1.20260815.1": true
  },
  "workspaces": [
    "packages/schema",
    "packages/control-plane",
    "packages/box/actor",
    "packages/webapp"
  ],
  "scripts": {
    "lint": "oxlint .",
    "lint:gate": "node scripts/lint-gate.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test packages/microvm-host/guest/blitz-microvm-enroll.test.js tools/oxlint/blitz-house/*.test.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.78.0",
    "jsdom": "29.0.0",
    "oxlint": "^1.78.0"
  }
}
