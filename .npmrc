# The vendored Lody renderer stack (packages/webapp) carries peerOptional
# `typescript@^5` ranges (react-i18next, and friends) while this repo is on
# TypeScript 7. npm treats an unsatisfiable peerOptional as a hard ERESOLVE, so
# `npm ci` in CI needs the same relaxation the first install needed.
# Remove this the day every vendored peer range accepts TS 7.
legacy-peer-deps=true
