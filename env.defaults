# box

# string: Agent backend used for new ACP sessions (claude or codex).
BLITZ_AGENT=claude

# string: Optional comma-separated browser origins allowed in addition to loopback origins.
BLITZ_ALLOWED_ORIGINS=

# string: Optional control-plane origin persisted into box state during initialization.
BLITZ_CP_ORIGIN=

# integer: Runtime group ID assigned to the blitz user inside the box.
BLITZ_GID=1000

# absolute path: Persistent state directory shared by box services and blitz-cred.
BLITZ_STATE_DIR=/var/lib/blitz

# integer: Runtime user ID assigned to the blitz user inside the box.
BLITZ_UID=1000

# boolean: Preserve the injected Docker environment when s6 launches box services.
S6_KEEP_ENV=1

# broker

# absolute path: Persistent state directory used by the broker daemon.
BLITZ_BROKER_STATE_DIR=/var/lib/blitz-broker

# control-plane (Cloudflare Worker vars are documentation-only here; wrangler.toml owns their values.)

# APP_URL (string): Public Worker origin; wrangler.toml supplies the runtime value.
# AWS_ACCESS_KEY_ID (secret string): AWS EC2/EBS credential; set as a Worker secret when that provider is used.
# AWS_IMAGE_ID (string): Optional AMI pin (ami-…); empty resolves the newest Canonical Ubuntu 24.04 amd64 image.
# AWS_REGION (string): AWS region for EC2 and EBS calls; required alongside the AWS credential.
# AWS_SECRET_ACCESS_KEY (secret string): AWS EC2/EBS credential; set as a Worker secret when that provider is used.
# AWS_SECURITY_GROUP_IDS (string): Optional comma-separated sg-… list; empty uses the VPC default group, which refuses inbound SSH.
# AWS_SESSION_TOKEN (secret string): Optional AWS session token for temporary credentials; set as a Worker secret.
# AWS_SUBNET_ID (string): Optional subnet-… pin; also fixes the availability zone an EBS volume must share to attach.
# BOX_IMAGE_REF (string): Box image reference or hosted image URL; wrangler.toml supplies the runtime value.
# BOX_IMAGE_SHA256 (string): Optional SHA-256 for a hosted box image archive; wrangler.toml supplies the runtime value.
# BOX_IMAGE_TAG (string): Optional local tag for a hosted box image archive; wrangler.toml supplies the runtime value.
# CLOUDFLARE_ACCOUNT_ID (string): Cloudflare account that owns workspace tunnels; wrangler.toml supplies the runtime value.
# CLOUDFLARE_API_TOKEN (secret string): Cloudflare API token with Tunnel Edit + DNS Edit; set as a Worker secret.
# CLOUDFLARE_ZONE_ID (string): Zone holding ws-<id> workspace hostnames; wrangler.toml supplies the runtime value.
# CRED_MASTER_KEY (secret string): Base64-encoded credential encryption key; set as a Worker secret.
# GITHUB_APP_CLIENT_ID (string): GitHub App client id for /connect/github; unset leaves the provider un-connectable and the picker says so.
# GITHUB_APP_CLIENT_SECRET (secret string): GitHub App client secret for /connect/github; set as a Worker secret.
# GOOGLE_CONNECT_CLIENT_ID (string): OAuth client id for /connect/google-workspace; separate from GOOGLE_CLIENT_ID, which is the login client.
# GOOGLE_CONNECT_CLIENT_SECRET (secret string): OAuth client secret for /connect/google-workspace; set as a Worker secret.
# HETZNER_API_TOKEN (secret string): Hetzner API credential; set as a Worker secret when that provider is used.
# JWT_SECRET_MAIN (secret string): Session-signing key; set as a Worker secret.
# LINEAR_CLIENT_ID (string): OAuth client id for /connect/linear; unset leaves the provider un-connectable and the picker says so.
# LINEAR_CLIENT_SECRET (secret string): OAuth client secret for /connect/linear; set as a Worker secret.
# MAX_CONCURRENT_WORKSPACES (integer): Maximum concurrent non-destroyed workspaces; wrangler.toml supplies the runtime value.
# MICROVM_HOSTS (JSON array): Configured microVM hosts and their secret binding names; wrangler.toml supplies the runtime value.
# MICROVM_LAB_TOKEN (secret string): Example dynamically referenced microVM host credential; set as a Worker secret.
# OPERATOR_API_KEY (secret string): Operator API credential; set as a Worker secret.
# RESPOND_WITH_ERRORS (boolean): Whether Teenybase responses include internal error details; the Worker platform supplies the runtime value.
# RESPOND_WITH_QUERY_LOG (boolean): Whether Teenybase responses include query logs; the Worker platform supplies the runtime value.
# SESSION_TTL_DAYS (integer): Session lifetime in days; wrangler.toml supplies the runtime value.
# WEBAPP_TOKEN_SECRET (secret string): HMAC key deriving per-workspace webApp tokens; set as a Worker secret.
# WORKSPACE_TUNNEL_ZONE (string): Zone name for workspace tunnel hostnames; empty disables tunnels; wrangler.toml supplies the runtime value.

# microvm-host

# number: CPU overcommit multiplier applied to physical host CPU capacity.
BLITZ_MICROVM_CPU_OVERCOMMIT=1

# absolute path: Installed Firecracker executable.
BLITZ_MICROVM_FIRECRACKER_BIN=/usr/local/bin/firecracker

# string: Firecracker version reported by the health endpoint.
BLITZ_MICROVM_FIRECRACKER_VERSION=v1.16.1

# JSON array of IPv4 strings: DNS resolvers written into each guest.
BLITZ_MICROVM_GUEST_DNS='["1.1.1.1","8.8.8.8"]'

# absolute path: Linux kernel image used to boot guests.
BLITZ_MICROVM_KERNEL_IMAGE=/var/lib/blitz-microvm/vmlinux

# string: Kernel version reported by the health endpoint.
BLITZ_MICROVM_KERNEL_VERSION=6.1.155

# string: Host address and port listened on by the agent API.
BLITZ_MICROVM_LISTEN_ADDR=0.0.0.0:8086

# integer: Maximum number of simultaneously allocated microVMs.
BLITZ_MICROVM_MAX_VMS=10

# integer: Starting third IPv4 octet used for guest network slots.
BLITZ_MICROVM_NETWORK_OCTET_BASE=20

# string: First two IPv4 octets used for host-only guest networks.
BLITZ_MICROVM_NETWORK_PREFIX=172.30

# string: Host name or address advertised for guest SSH; deployment must set this host-specific value.
BLITZ_MICROVM_PUBLIC_HOST_IP=

# absolute path: Read-only root filesystem image used to boot guests.
BLITZ_MICROVM_ROOTFS_IMAGE=/var/lib/blitz-microvm/rootfs.ext4

# integer: Seconds allowed for graceful guest shutdown before termination.
BLITZ_MICROVM_SHUTDOWN_TIMEOUT_SECONDS=10

# integer: Number of host network and SSH-port slots available to the agent.
BLITZ_MICROVM_SLOT_COUNT=10

# integer: First host port reserved for guest SSH forwarding.
BLITZ_MICROVM_SSH_PORT_BASE=22000

# absolute path: Persistent agent state and runtime directory.
BLITZ_MICROVM_STATE_DIR=/var/lib/blitz-microvm

# absolute path: Privileged command wrapper used for network operations.
BLITZ_MICROVM_SUDO_WRAPPER=/usr/local/libexec/blitz-microvm-sudo

# absolute path: Protected file containing the agent bearer token.
BLITZ_MICROVM_TOKEN_FILE=/etc/blitz/microvm-agent-token

# integer: Physical host CPU capacity; deployment must set this host-specific value.
BLITZ_MICROVM_TOTAL_CPU=

# integer: Physical host memory capacity in MiB; deployment must set this host-specific value.
BLITZ_MICROVM_TOTAL_MEM_MB=

# integer: Sparse writable upper-disk size in bytes for each guest.
BLITZ_MICROVM_UPPER_SIZE_BYTES=8589934592

# string: Control-plane origin used by the optional tunnel reporter; deployment sets it when enabling the reporter.
CP_URL=

# string: Registered microVM host name used by the optional tunnel reporter; deployment sets it when enabling the reporter.
HOST_NAME=

# absolute path: Protected file containing the tunnel reporter bearer token.
TOKEN_FILE=/etc/blitz/microvm-agent-token

# ui

# public string: Optional separate control-plane origin; empty uses the UI's own origin.
VITE_CONTROL_PLANE_URL=
